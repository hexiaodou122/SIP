{
  "name": "sip",
  "productName": "Sip",
  "version": "0.1.0",
  "description": "用屏幕上的水位陪你喝水",
  "main": "main/main.js",
  "private": true,
  "scripts": {
    "prestart": "node scripts/build-helper.js",
    "start": "electron .",
    "predev": "node scripts/build-helper.js",
    "dev": "SIP_DEV=1 electron .",
    "preview": "node scripts/preview.js",
    "helper": "node scripts/build-helper.js",
    "icons": "node scripts/make-tray-icons.js",
    "predist": "node scripts/build-helper.js",
    "dist": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "app.sip.water",
    "productName": "Sip",
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": "dmg",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "files": [
      "main/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/sip-mouse",
        "to": "bin/sip-mouse"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
