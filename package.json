{
  "name": "sip",
  "productName": "喝水养鱼",
  "version": "0.1.1",
  "description": "喝水养鱼 · SIP：你喝水，桌面养鱼",
  "main": "main/main.js",
  "private": true,
  "scripts": {
    "prestart": "node scripts/build-helper.js",
    "start": "electron .",
    "predev": "node scripts/build-helper.js",
    "dev": "SIP_DEV=1 electron .",
    "preview": "node scripts/preview.js",
    "helper": "node scripts/build-helper.js",
    "icons": "node scripts/make-tray-icons.js",
    "predist": "node scripts/build-helper.js",
    "dist": "electron-builder --mac --dir --arm64 && node scripts/make-dmg.js",
    "test": "node --test tests/*.test.js",
    "capture": "electron scripts/capture-visuals.js",
    "dist:local": "electron-builder --mac --dir --arm64 --config.electronDist=node_modules/electron/dist && node scripts/make-dmg.js",
    "verify:package": "node scripts/verify-package.js",
    "predist:local": "node scripts/build-helper.js"
  },
  "build": {
    "appId": "app.sip.water",
    "productName": "喝水养鱼",
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": "dmg",
      "extendInfo": {
        "LSUIElement": true
      },
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false
    },
    "files": [
      "main/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/sip-mouse",
        "to": "bin/sip-mouse"
      }
    ],
    "artifactName": "Sip-${version}-mac-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
